; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="barkvr"
run/main_scene="res://barkvr-system/startup/main.tscn"
run/enable_alt_space_menu=true
config/use_custom_user_dir=true
config/custom_user_dir_name="bark"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="res://barkvr-system/assets/icons/barkiconrounded.png"
config/icon="uid://cevwfpahxlnpo"
config/windows_native_icon="res://barkvr-system/assets/barkvrcorgi.ico"

[audio]

buses/default_bus_layout="uid://bnxndu834y4ws"
driver/enable_input=true
driver/mix_rate=48000

[autoload]

LocalGlobals="*res://barkvr-system/managers/localGlobals.gd"
BarkHelpers="*res://barkvr-system/lib/bark_helpers.gd"
Notifyvr="*res://addons/notifyvr/notifyvr.gd"

[bark]

webrtc_config/stun_servers=PackedStringArray("stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302", "stun:stun2.l.google.com:19302", "stun:stun3.l.google.com:19302", "stun:stun4.l.google.com:19302")
webrtc_config/turn_servers=PackedStringArray()
webrtc_config/turn_password=""
webrtc_config/turn_username=""

[debug]

file_logging/log_path="user://logs/barkvr.log"
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1500
window/size/viewport_height=800
display_server/driver.linuxbsd="wayland"
window/handheld/orientation=6

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/Panel3D/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/contextmenu/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/unidot_importer/plugin.cfg", "res://addons/vrm/plugin.cfg")

[filesystem]

import/fbx2gltf/enabled.android=true
import/fbx2gltf/enabled.web=true
import/blender/enabled=false

[global_group]

player_xr_origin=""
localuinode=""
startxr="group specifically for the XR init node"

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
common/text_edit_undo_stack_max_size=4096
theme/custom="res://barkvr-system/assets/barkvr_theme.tres"

